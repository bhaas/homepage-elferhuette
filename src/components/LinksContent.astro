---
import { Image } from 'astro:assets';
import type { Locale } from '../data/site';
import { hotelKlimaHref, linksContent } from '../data/links';
import hotelKlimaImage from '../assets/elferhuette/hotel-klima.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = linksContent[lang];
---

<main class="links-page">
  <div class="shell">
    <header class="links-page__intro">
      <div class="kicker">{content.overline}</div>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>

    <a class="links-feature" href={hotelKlimaHref} target="_blank" rel="noopener">
      <Image
        class="links-feature__image"
        src={hotelKlimaImage}
        alt={content.featured.imageAlt}
        widths={[600, 900, 1200]}
        sizes="(max-width: 900px) 100vw, 560px"
      />
      <div class="links-feature__body">
        <div class="kicker">{content.featured.label}</div>
        <h2>{content.featured.title}</h2>
        <p>{content.featured.text}</p>
        <span class="links-feature__cta">{content.featured.linkLabel} → <span class="links-feature__url">www.hotel-klima.com</span></span>
      </div>
    </a>

    <div class="links-groups">
      {content.groups.map((group) => (
        <section class="links-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  <strong>{link.name}</strong>
                  <span>{link.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <aside class="links-emergency">
      <a href="tel:140" class="links-emergency__number">140</a>
      <div>
        <strong>{content.emergency.title}</strong>
        <p>{content.emergency.text}</p>
      </div>
    </aside>
  </div>
</main>

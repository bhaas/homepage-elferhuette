---
import { Image, getImage } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import { contact, galleryItems, images, locales, siteContent, type Locale } from '../../data/site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = siteContent[lang];

if (!page) {
  throw new Error(`Unsupported language: ${Astro.params.lang}`);
}

const sectionIds = {
  de: { experience: 'erleben', gallery: 'galerie', hospitality: 'einkehren', stay: 'uebernachten', prices: 'preise', history: 'geschichte', arrival: 'anreise', contact: 'kontakt' },
  en: { experience: 'experience', gallery: 'gallery', hospitality: 'hospitality', stay: 'stay', prices: 'prices', history: 'history', arrival: 'arrival', contact: 'contact' },
  it: { experience: 'esperienza', gallery: 'galleria', hospitality: 'ospitalita', stay: 'pernottamento', prices: 'prezzi', history: 'storia', arrival: 'arrivo', contact: 'contatto' },
} as const;

const ids = sectionIds[lang];
const gallery = await Promise.all(
  galleryItems.map(async (item) => ({
    ...item,
    caption: item.caption[lang],
    full: await getImage({ src: images[item.imageKey], width: 1800, format: 'webp' }),
  })),
);
const languageLabels = { de: 'DE', en: 'EN', it: 'IT' } as const;
const navLabels = { de: 'Hauptnavigation', en: 'Main navigation', it: 'Navigazione principale' } as const;
const languageSwitcherLabels = { de: 'Sprachauswahl', en: 'Language switcher', it: 'Selettore lingua' } as const;
const skipLabels = {
  de: 'Zum Hauptinhalt springen',
  en: 'Skip to main content',
  it: 'Vai al contenuto principale',
} as const;
const canonicalHost = 'https://www.elferhuette.at';
const canonicalUrl = `${canonicalHost}/${lang}/`;
const alternates = [
  ...locales.map((item) => ({ hrefLang: item, href: `${canonicalHost}/${item}/` })),
  { hrefLang: 'x-default', href: `${canonicalHost}/de/` },
];

const ogImageAsset = await getImage({ src: images.heroClouds, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = { src: ogImageAsset.src, width: 1200, height: 630, alt: page.hero.imageAlt };
const schemaImages = await Promise.all(
  [images.heroClouds, images.winterHut, images.hutStube, images.galleryAerial].map(
    async (src) => new URL((await getImage({ src, width: 1600, format: 'jpg' })).src, canonicalHost).href,
  ),
);
const hutId = `${canonicalHost}/#elferhuette`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LodgingBusiness', 'Restaurant'],
      '@id': hutId,
      name: 'Elferhütte',
      alternateName: ['Elferhütte Restaurant', 'Bergrestaurant Elferhütte', 'Wanderzentrum Elferhütte'],
      description: page.meta.description,
      url: canonicalUrl,
      image: schemaImages,
      logo: `${canonicalHost}/icon-512.png`,
      telephone: '+43 5226 2818',
      email: contact.emailLabel,
      vatID: contact.vatId,
      foundingDate: '1933',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Elferhütte 294',
        postalCode: '6167',
        addressLocality: 'Neustift im Stubaital',
        addressRegion: 'Tirol',
        addressCountry: 'AT',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 47.09507, longitude: 11.31951, elevation: 2080 },
      hasMap: contact.mapsHref,
      containedInPlace: { '@type': 'Place', name: 'Stubaital, Tirol' },
      servesCuisine: ['Tiroler Küche', 'Österreichische Küche'],
      acceptsReservations: true,
      currenciesAccepted: 'EUR',
      priceRange: '€€',
      amenityFeature: [
        { '@type': 'LocationFeatureSpecification', name: 'WLAN', value: true },
        { '@type': 'LocationFeatureSpecification', name: 'Panoramaterrasse', value: true },
      ],
      makesOffer: page.prices.offers.map((offer) => ({
        '@type': 'Offer',
        name: offer.name,
        description: offer.detail,
        price: offer.price,
        priceCurrency: 'EUR',
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalHost}/#website`,
      url: `${canonicalHost}/`,
      name: 'Elferhütte',
      inLanguage: [...locales],
      publisher: { '@id': hutId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: page.meta.title,
      description: page.meta.description,
      inLanguage: lang,
      isPartOf: { '@id': `${canonicalHost}/#website` },
      about: { '@id': hutId },
      primaryImageOfPage: schemaImages[0],
    },
  ],
};
---

<MainLayout
  title={page.meta.title}
  description={page.meta.description}
  locale={lang}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  ogImage={ogImage}
  structuredData={structuredData}
>
  <a class="skip-link" href="#main-content">{skipLabels[lang]}</a>
  <header class="site-header">
    <div class="shell header__inner">
      <a class="wordmark notranslate" translate="no" href={`/${lang}/`} aria-label="Elferhütte">
        <span class="wordmark__name">Elferhütte</span>
        <span class="wordmark__place">2.080 m · Stubaital</span>
      </a>

      <nav class="nav" aria-label={navLabels[lang]}>
        {page.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="language-switcher notranslate" translate="no" aria-label={languageSwitcherLabels[lang]}>
        {locales.map((item) => (
          <a href={`/${item}/`} lang={item} hreflang={item} aria-current={item === lang ? 'page' : undefined}>
            {languageLabels[item]}
          </a>
        ))}
      </div>
    </div>
  </header>

  <main id="main-content">
    <section class="hero">
      <Image
        class="hero__image"
        src={images.heroClouds}
        alt={page.hero.imageAlt}
        widths={[960, 1440, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__shade"></div>
      <div class="shell hero__content">
        <div class="hero__eyebrow">{page.hero.overline}</div>
        <h1>{page.hero.title}</h1>
        <p>{page.hero.text}</p>
        <div class="hero__actions">
          <a class="button button--light" href={contact.emailHref}>{page.hero.primary}</a>
          <a class="button button--ghost" href={`#${ids.experience}`}>{page.hero.secondary}</a>
        </div>
        <ul class="hero__facts">
          {page.hero.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </section>

    <section class="section section--intro">
      <div class="shell split split--intro">
        <div class="section-copy">
          <span class="kicker">{page.intro.label}</span>
          <h2>{page.intro.title}</h2>
          <p>{page.intro.text}</p>
          <div class="stats">
            {page.intro.stats.map((stat) => (
              <div class="stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
        <figure class="image-frame image-frame--tall">
          <Image
            src={images.winterHut}
            alt={page.intro.imageAlt}
            widths={[720, 1080, 1440]}
            sizes="(max-width: 900px) 100vw, 44vw"
          />
        </figure>
      </div>
    </section>

    <section class="section section--soft" id={ids.experience}>
      <div class="shell">
        <div class="section-heading section-heading--center">
          <span class="kicker">{page.experiences.label}</span>
          <h2>{page.experiences.title}</h2>
        </div>
        <div class="experience-grid">
          {page.experiences.cards.map((card) => (
            <article class="experience-card">
              <Image
                src={images[card.imageKey]}
                alt={card.imageAlt}
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 33vw"
              />
              <div class="experience-card__body">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--gallery" id={ids.gallery}>
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">{page.gallery.label}</span>
          <h2>{page.gallery.title}</h2>
          <p>{page.gallery.text}</p>
        </div>
        <ul class="gallery-grid" data-gallery>
          {gallery.map((item, index) => (
            <li class:list={['gallery-item', item.layout && `gallery-item--${item.layout}`]}>
              <button
                type="button"
                class="gallery-item__button"
                data-gallery-index={index}
                data-full={item.full.src}
                data-caption={item.caption}
                data-credit={item.credit ? `${page.gallery.photo}: ${item.credit.author} · ${item.credit.license}` : ''}
                data-credit-href={item.credit?.href ?? ''}
                aria-label={`${page.gallery.open}: ${item.caption}`}
              >
                <Image
                  src={images[item.imageKey]}
                  alt={item.caption}
                  widths={item.layout === 'feature' || item.layout === 'wide' ? [640, 960, 1400] : [480, 720, 960]}
                  sizes={item.layout === 'feature' || item.layout === 'wide' ? '(max-width: 580px) 100vw, 50vw' : '(max-width: 580px) 100vw, (max-width: 900px) 50vw, 25vw'}
                  loading="lazy"
                  style={item.position ? `object-position: ${item.position}` : undefined}
                />
                <span class="gallery-item__caption">{item.caption}</span>
              </button>
              {item.credit && (
                <a class="gallery-item__credit" href={item.credit.href} target="_blank" rel="noopener">
                  © {item.credit.author} · {item.credit.license}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
      <dialog class="lightbox" data-lightbox aria-label={page.gallery.label}>
        <button type="button" class="lightbox__close" data-lightbox-close aria-label={page.gallery.close}>×</button>
        <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label={page.gallery.previous}>‹</button>
        <figure class="lightbox__figure">
          <img data-lightbox-image alt="" />
          <figcaption>
            <span data-lightbox-caption></span>
            <a data-lightbox-credit target="_blank" rel="noopener"></a>
          </figcaption>
        </figure>
        <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label={page.gallery.next}>›</button>
      </dialog>
    </section>

    <section class="section" id={ids.hospitality}>
      <div class="shell split split--hospitality">
        <figure class="image-frame image-frame--wide">
          <Image
            src={images[page.hospitality.imageKey]}
            alt={page.hospitality.imageAlt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 900px) 100vw, 45vw"
          />
        </figure>
        <div class="section-copy section-copy--inset">
          <span class="kicker">{page.hospitality.label}</span>
          <h2>{page.hospitality.title}</h2>
          <p>{page.hospitality.text}</p>
          <ul class="tick-list">
            {page.hospitality.points.map((point) => <li>{point}</li>)}
          </ul>
          <p class="notice">{page.hospitality.note}</p>
        </div>
      </div>
    </section>

    <section class="section section--dark" id={ids.stay}>
      <div class="shell split split--stay">
        <div class="section-copy section-copy--light">
          <span class="kicker">{page.stay.label}</span>
          <h2>{page.stay.title}</h2>
          <p>{page.stay.text}</p>
          <ul class="tick-list">
            {page.stay.points.map((point) => <li>{point}</li>)}
          </ul>
          <a class="button button--sand" href={contact.emailHref}>{page.stay.primary}</a>
        </div>
        <figure class="image-frame image-frame--stay">
          <Image
            src={images.hutStube}
            alt={page.stay.imageAlt}
            widths={[720, 1080, 1440]}
            sizes="(max-width: 900px) 100vw, 45vw"
          />
        </figure>
      </div>
    </section>

    <section class="section section--soft" id={ids.prices}>
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">{page.prices.label}</span>
          <h2>{page.prices.title}</h2>
          <p>{page.prices.text}</p>
        </div>
        <div class="price-layout">
          <div class="price-offers">
            {page.prices.offers.map((offer) => (
              <article class:list={['price-card', offer.badge && 'price-card--featured']}>
                {offer.badge && <span class="price-card__badge">{offer.badge}</span>}
                <h3>{offer.name}</h3>
                <p class="price-card__amount">
                  <span class="price-card__currency">€</span>
                  <strong>{offer.price}</strong>
                </p>
                <p class="price-card__unit">{page.prices.perNight}</p>
                <p class="price-card__detail">{offer.detail}</p>
              </article>
            ))}
          </div>
          <div class="price-info">
            <div>
              <h3>{page.prices.includedTitle}</h3>
              <ul class="check-list">
                {page.prices.included.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3>{page.prices.extrasTitle}</h3>
              <dl class="price-extras">
                {page.prices.extras.map((extra) => (
                  <div>
                    <dt>{extra.label}</dt>
                    <dd>{extra.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="price-note">{page.prices.extrasNote}</p>
            </div>
          </div>
        </div>
        <div class="price-footer">
          <ul class="price-rules">
            {page.prices.notes.map((note) => <li>{note}</li>)}
          </ul>
          <a class="button button--dark" href={contact.emailHref}>{page.prices.primary}</a>
        </div>
        <p class="price-quote">{page.prices.quote}</p>
      </div>
    </section>

    <section class="section section--history" id={ids.history}>
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">{page.history.label}</span>
          <h2>{page.history.title}</h2>
          <p>{page.history.text}</p>
        </div>
        <div class="history-photos">
          {page.history.photos.map((photo) => (
            <figure class="history-photo">
              <Image src={images[photo.imageKey]} alt={photo.alt} widths={[400, 640, 900]} sizes="(max-width: 580px) 100vw, (max-width: 900px) 50vw, 25vw" loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
        <div class="history-layout">
          <ol class="timeline">
            {page.history.milestones.map((milestone) => (
              <li class="timeline__item">
                <span class="timeline__year">{milestone.year}</span>
                <div>
                  <h3>{milestone.title}</h3>
                  <p>{milestone.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <aside class="history-aside">
            <div class="history-card">
              <h3>{page.history.factsTitle}</h3>
              <ul class="check-list">
                {page.history.facts.map((fact) => <li>{fact}</li>)}
              </ul>
            </div>
            <div class="history-card history-card--appeal">
              <h3>{page.history.appealTitle}</h3>
              <p>{page.history.appeal}</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="section" id={ids.arrival}>
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">{page.arrival.label}</span>
          <h2>{page.arrival.title}</h2>
          <p>{page.arrival.text}</p>
        </div>
        <div class="arrival-grid">
          {page.arrival.items.map((item, index) => (
            <article class="arrival-item">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <div class="map-block">
          <div class="map-info">
            <h3>{page.arrival.mapTitle}</h3>
            <span class="map-info__label">{page.arrival.addressLabel}</span>
            <address>
              {contact.addressLines.map((line) => <span>{line}</span>)}
            </address>
            <a class="button button--dark" href={contact.mapsHref} target="_blank" rel="noopener">{page.arrival.mapOpen} ↗</a>
          </div>
          <div class="map-frame" data-map data-src={contact.mapsEmbedSrc.replace('__LANG__', lang)} data-title={page.arrival.mapFrameTitle}>
            <div class="map-consent">
              <p>{page.arrival.mapNotice}</p>
              <button type="button" class="button button--dark" data-map-load>{page.arrival.mapLoad}</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="contact" id={ids.contact}>
      <div class="shell contact__inner">
        <div>
          <span class="kicker">{page.contact.label}</span>
          <h2>{page.contact.title}</h2>
          <p>{page.contact.text}</p>
        </div>
        <div class="contact__links">
          <a href={contact.phoneHref}>
            <span>{page.contact.phoneText}</span>
            <strong>{contact.phoneLabel}</strong>
          </a>
          <a href={contact.emailHref}>
            <span>{page.contact.emailText}</span>
            <strong>{contact.emailLabel}</strong>
          </a>
          <div class="contact__bank" translate="no">
            <span>{page.contact.bankText}</span>
            <strong>{contact.bank.name}</strong>
            <dl>
              <div><dt>IBAN</dt><dd>{contact.bank.iban}</dd></div>
              <div><dt>BIC</dt><dd>{contact.bank.bic}</dd></div>
              <div><dt>{page.contact.vatIdText}</dt><dd>{contact.vatId}</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer__inner">
      <span class="wordmark__name">Elferhütte</span>
      <span>{page.contact.footer}</span>
      <a href={contact.emailHref}>{contact.emailLabel}</a>
    </div>
  </footer>
</MainLayout>

<script>
  const mapFrame = document.querySelector<HTMLElement>('[data-map]');
  mapFrame?.querySelector('[data-map-load]')?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = mapFrame.dataset.src ?? '';
    iframe.title = mapFrame.dataset.title ?? '';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.allowFullscreen = true;
    mapFrame.replaceChildren(iframe);
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-index]'));

  if (dialog && buttons.length) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const credit = dialog.querySelector<HTMLAnchorElement>('[data-lightbox-credit]')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length;
      const data = buttons[current].dataset;
      image.src = data.full ?? '';
      image.alt = data.caption ?? '';
      caption.textContent = data.caption ?? '';
      credit.textContent = data.credit ?? '';
      credit.hidden = !data.credit;
      if (data.creditHref) credit.href = data.creditHref;
    };

    buttons.forEach((button, index) =>
      button.addEventListener('click', () => {
        show(index);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('close', () => buttons[current]?.focus());
  }
</script>

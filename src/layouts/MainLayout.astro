---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: string;
  canonicalUrl?: string;
  alternates?: Array<{ hrefLang: string; href: string }>;
  ogImage?: { src: string; width: number; height: number; alt: string };
  structuredData?: Record<string, unknown>;
}

const { title, description, locale, canonicalUrl, alternates = [], ogImage, structuredData } = Astro.props;
const ogLocales: Record<string, string> = { de: 'de_AT', en: 'en_GB', it: 'it_IT' };
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site ?? canonicalUrl).href : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1b3024" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />
    ))}
    <meta name="geo.region" content="AT-7" />
    <meta name="geo.placename" content="Neustift im Stubaital" />
    <meta name="geo.position" content="47.09507;11.31951" />
    <meta name="ICBM" content="47.09507, 11.31951" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elferhütte" />
    <meta property="og:locale" content={ogLocales[locale] ?? locale} />
    {Object.entries(ogLocales)
      .filter(([key]) => key !== locale)
      .map(([, value]) => <meta property="og:locale:alternate" content={value} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImage && <meta property="og:image:width" content={String(ogImage.width)} />}
    {ogImage && <meta property="og:image:height" content={String(ogImage.height)} />}
    {ogImage && <meta property="og:image:alt" content={ogImage.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
